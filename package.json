{
  "name": "sentra-prompt",
  "version": "0.1.1",
  "private": true,
  "main": "dist-electron/desktop/bootstrap.js",
  "//packageManager": "Pinned so this app resolves deterministically after being copied out of the ABYSS monorepo — App Independence promises 'clone and run', which an arbitrary local pnpm version does not deliver. Matches the ABYSS root toolchain today; once independent this app may move ahead of root on its own schedule.",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm run desktop:build",
    "dev": "pnpm run desktop:dev",
    "start": "pnpm run desktop:dev",
    "desktop:build": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force dist-electron -ErrorAction SilentlyContinue; New-Item -ItemType Directory -Force dist-electron/desktop/renderer | Out-Null\" && pnpm run db:generate && pnpm exec tsc -p tsconfig.desktop.json && powershell -NoProfile -Command \"Copy-Item desktop/renderer/index.html dist-electron/desktop/renderer/index.html -Force; Copy-Item desktop/renderer/index.css dist-electron/desktop/renderer/index.css -Force\"",
    "desktop:benchmark": "tsx scripts/optimizer-acceptance.ts --json",
    "desktop:dev": "pnpm run desktop:build && electron ./dist-electron/desktop/bootstrap.js",
    "desktop:smoke": "pnpm run desktop:build && powershell -NoProfile -Command \"$env:SENTRA_DESKTOP_SMOKE='1'; & .\\node_modules\\.bin\\electron.cmd .\\dist-electron\\desktop\\bootstrap.js\"",
    "lint": "eslint .",
    "audit:security": "pnpm audit",
    "optimizer:acceptance": "tsx scripts/optimizer-acceptance.ts",
    "typecheck": "pnpm run db:generate && tsc --noEmit",
    "pretest": "tsx scripts/optimizer-acceptance.ts --dry-run",
    "test": "vitest run",
    "test:desktop": "vitest run tests/unit/desktop",
    "test:e2e": "pnpm run desktop:build && playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "node -e \"process.env.DATABASE_URL ||= 'postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=public'; process.env.DIRECT_URL ||= process.env.DATABASE_URL; const { spawnSync } = require('node:child_process'); const result = spawnSync(process.execPath, ['./node_modules/prisma/build/index.js', 'generate'], { stdio: 'inherit', env: process.env }); process.exit(result.status ?? 1);\"",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:resolve:init": "prisma migrate resolve --applied 20260322000000_init",
    "db:migrate:apply": "powershell -ExecutionPolicy Bypass -File ./scripts/apply-prisma-migrations.ps1",
    "db:seed": "tsx prisma/seed.ts",
    "deploy:dry-run": "node scripts/deploy-dry-run.mjs",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:extraction": "node scripts/verify-extraction.mjs",
    "verify": "pnpm run verify:structure && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run desktop:smoke && pnpm run deploy:dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@hookform/resolvers": "^3.9.0",
    "@mistralai/mistralai": "^1.5.0",
    "@next/env": "15.5.25",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@sentry/nextjs": "^10.45.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.0",
    "@vercel/analytics": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "geist": "^1.7.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "openai": "^4.85.0",
    "pg": "^8.20.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.60.0",
    "resend": "^6.9.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "electron": "^44.4.3",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.2.1",
    "globals": "^17.4.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.11"
  }
}
